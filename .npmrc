# Do not auto-install peer dependencies (npm 7+ default).
#
# @do-md/commands declares a peer dependency on @do-md/core-react, but the kernel is not an
# npm dependency of this app any more: its source lives in .packages/@do-md/core/ and is
# resolved through tsconfig paths. Letting npm satisfy that peer from the registry would put
# a second, stale copy of the kernel in node_modules — two resolvable kernels on disk, with
# the bundler free to pick either one. (@do-md/commands only imports the kernel with
# `import type`, so nothing needs it at runtime.)
#
# The kernel package has the same setting for the same class of reason: see
# .packages/@do-md/core/.npmrc — there it keeps a second React out of the tree.
legacy-peer-deps=true
