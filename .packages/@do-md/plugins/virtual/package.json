{
    "name": "@do-md/virtual",
    "version": "0.1.0",
    "description": "DOM virtualization policy for the @do-md/core-react editor — viewport window rendering over the kernel's render-window seam: height cache, prefix-sum table, overscan + hysteresis, scroll anchoring, scrollToBlock/pin API",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "vite build && node scripts/build-types.mjs",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "rm -rf dist && npm run build"
    },
    "peerDependencies": {
        "@do-md/core-react": ">=0.12.4",
        "@do-md/zenith": ">=2.0.3",
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@do-md/core-react": "^0.12.4",
        "@do-md/zenith": "^2.0.3",
        "@microsoft/api-extractor": "^7.58.13",
        "typescript": "^5.6.0",
        "vite": "^7.2.2"
    },
    "sideEffects": false,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/do-md/domd.git",
        "directory": ".packages/@do-md/plugins/virtual"
    },
    "keywords": [
        "domd",
        "markdown",
        "editor",
        "virtualization",
        "virtual-scroll",
        "windowing",
        "performance"
    ]
}
