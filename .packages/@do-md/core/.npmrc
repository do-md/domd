# Do not auto-install peerDependencies (react / react-dom / immer).
#
# The kernel lives at .packages/@do-md/core/ inside the app repo, a subdirectory of
# apps/domd: the moment a copy of react also exists in the node_modules here, the
# "nearest node_modules" resolution of Node/webpack makes the kernel source hit its own
# copy while the app code hits the app's — two React instances on one page, a null hooks
# dispatcher, contexts that never match. Having the outer level supply the peers is
# exactly the semantics peers are meant to have:
#   app build       → resolves to apps/domd/node_modules/react (the only copy)
#   vite build      → react/react-dom/immer are external anyway, never bundled
#   verify scripts  → also resolve upwards to the app's copy, matching the real runtime
legacy-peer-deps=true
